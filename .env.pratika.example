# ==============================================================================
# PRÁTIKA FACILITIES - CONFIGURAÇÃO DE PRODUÇÃO CHATWOOT
# ==============================================================================

# --- BRANDING & WHITE-LABEL ---
INSTALLATION_NAME=Prátika Facilities
BRAND_NAME=Prátika Facilities
BRAND_URL=https://pratika.com.br
WIDGET_BRAND_URL=https://pratika.com.br
TERMS_URL=https://pratika.com.br/privacidade
PRIVACY_URL=https://pratika.com.br/privacidade
LOGO=/brand-assets/logo.svg
LOGO_DARK=/brand-assets/logo_dark.svg
LOGO_THUMBNAIL=/brand-assets/logo_thumbnail.svg
DISPLAY_MANIFEST=false

# --- AMBIENTE & DOMÍNIO ---
SECRET_KEY_BASE=generate_with_rake_secret_or_openssl_rand_hex_64
FRONTEND_URL=https://atendimento.pratika.com.br
NODE_ENV=production
RAILS_ENV=production
RAILS_MAX_THREADS=5
DEFAULT_LOCALE=pt_BR

# --- BANCO DE DADOS (POSTGRESQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=pratika_secret_db_2026

# --- REDIS & SIDEKIQ ---
REDIS_URL=redis://:pratika_redis_pass_2026@redis:6379/0
REDIS_PASSWORD=pratika_redis_pass_2026

# --- E-MAIL TRANSACIONAL (SMTP) ---
MAILER_SENDER_EMAIL=atendimento@pratika.com.br
SMTP_ADDRESS=smtp.pratika.com.br
SMTP_PORT=587
SMTP_USERNAME=atendimento@pratika.com.br
SMTP_PASSWORD=sua_senha_smtp_aqui
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- ARMAZENAMENTO DE ARQUIVOS ---
ACTIVE_STORAGE_SERVICE=local

# --- REGISTRO DE CONTAS ---
ENABLE_ACCOUNT_SIGNUP=false
